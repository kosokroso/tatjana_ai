# Nastavitve restavracijskega agenta (restavracija.py).
# Kopiraj v .env.miza (ni v gitu) in izpolni. Ključev ne pošiljaj v klepet.
#
# Deploy v ločen LiveKit projekt "miza" (brezplačni paket dovoli enega agenta
# na projekt; "tatjana" in "maja" sta zasedena):
#   prvič:  lk --project miza --config livekit-miza.toml agent create --region eu-central --secrets-file .env.miza .
#   nato:   lk --project miza --config livekit-miza.toml agent deploy --secrets-file .env.miza .
# --config je obvezen: brez njega create zapiše livekit.toml in povozi
# povezavo na agenta Tatjane.
#
# POZOR lokalno: agent.py ob uvozu prebere tudi .env (Tatjana). Kar tu manjka,
# se vzame od tam. Zato LIVEKIT_* VEDNO nastavi tu, sicer se "dev" prijavi v
# projekt tatjana.

# Kateri program izbere agent.py ob zagonu. Brez tega teče agencija.
# LIVEKIT_* spodaj so samo za lk na računalniku; workflow jih agentu NE pošlje
# (LiveKit Cloud jih vstavi sam).
AGENT_ZAGON=restavracija.py
# Ime za dispatch pravilo in za štetje porabe Krisp na strežniku.
AGENT_IME=tatjana-miza

# LiveKit projekt "miza" (Cloud -> Settings -> Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Aplikacija Tatjana Miza. Ključ je v aplikaciji pod Nastavitve.
MIZA_API_URL=https://kreativnisplet.si/miza/api.php
MIZA_API_KEY=

# Vratar za meje klicev (ai/call-guard.php na strežniku Tatjane). Ista
# skrivnost kot v .env. Opomba: dnevna meja minut je skupna z agencijo.
TOOLS_BASE_URL=https://kreativnisplet.si/asistent
TOOL_SECRET=

# Prepis, model, glas: enako kot v .env.example.
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe
LLM_MODEL=gpt-5.6-sol
LLM_PREDPOMNILNIK=tatjana-miza
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE=sl-SI-PetraNeural
TTS_PONUDNIK=azure

VAD_TISINA=0.55
KLIC_MAX_SEK=600
TISINA_VPRASAJ=15
TISINA_KONEC=20
