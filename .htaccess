# .git/ vsebuje celotno zgodovino kode — ne sme biti dosegljiva prek brskalnika.
# DirectoryMatch v .htaccess kontekstu ni veljaven (samo v glavni konfiguraciji
# strežnika) in je na tem LiteSpeed hostingu povzročil, da je bila CELA mapa
# nedosegljiva (404 na vseh datotekah). RewriteRule je edina varna pot v .htaccess.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} \.git(/|$) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# Spletni klepet je ukinjen (17. 10. 2026), index.html ne obstaja vec. Brez
# DirectoryIndex vrne /asistent/ 403, ker ni ne zacetne datoteke ne izpisa mape.
# RewriteRule ^$ na tem LiteSpeed gostovanju ni delovala, DirectoryIndex pa je.
DirectoryIndex asistent.html
Options -Indexes
