# Logi vsebujejo podatke o klicih strank in ne smejo biti dosegljivi prek brskalnika.
# Na shared hostingu mapa leži znotraj web roota, zato je ta zaščita nujna.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
