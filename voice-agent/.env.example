# LiveKit (Cloud -> Settings -> Keys)
LIVEKIT_URL=wss://tvoj-projekt.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tvoj streznik z orodji in sistemskim promptom
TOOLS_BASE_URL=https://kreativnisplet.si/asistent
TOOL_SECRET=

# OpenAI (prepis govora in model)
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe
LLM_MODEL=gpt-4o-mini
# 0,3 zveni kot posnetek, 0,6 kot pogovor
LLM_TEMPERATURE=0.6

# Azure - NEOBVEZNO za prvi test, a mocno priporoceno.
# Brez kljuca agent uporabi OpenAI glas IN OpenAI prepis: slabsa slovenscina
# in nekaj sekund vec zamika na vsak obrat pogovora.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=italynorth
AZURE_TTS_VOICE=sl-SI-PetraNeural
# Telefon prenese 8 kHz. Visja vrednost pomeni vec podatkov in prevzorcenje,
# kar se pri daljsih odgovorih slisi kot praskanje.
TTS_SAMPLE_RATE=16000
# Koliko milisekund tisine Azure steje za konec povedi.
STT_TISINA_MS=500

# OpenAI glas, kadar Azure ni nastavljen
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=shimmer

# Zaznava premora. Edine vrednosti, ki jih ni mogoce nastaviti vnaprej -
# odvisne so od tega, kako hitro govorijo pravi klicatelji.
# VAD_TISINA: koliko sekund tisine pomeni "nehal je govoriti".
#   prenizko = asistentka skoci v besedo, previsoko = neroden molk
VAD_TISINA=0.55
VAD_GOVOR=0.10
VAD_PRAG=0.5

# Meje za konec govora. Nizja KONEC_MIN = hitrejsi odziv, a vec prekinjanja.
KONEC_MIN=0.4
KONEC_MAX=3.0

# Prekinjanje. Telefonska linija sumi, zato privzetih 0.5 s zvoka utisa
# asistentko sredi stavka. Visje = manj sekanja, a pocasnejsi odziv, kadar
# jo klicatelj res prekine.
PREKIN_SEK=0.7
PREKIN_BESEDE=2
PREKIN_LAZNA=1.5

# Najdaljsi posamezen klic v sekundah. Velja samo, kadar ai/call-guard.php ni
# dosegljiv - sicer meje doloci CALL_MAX_SECONDS v config.php na gostovanju.
KLIC_MAX_SEK=600

