# .git/ vsebuje celotno zgodovino kode — ne sme biti dosegljiva prek brskalnika.
# DirectoryMatch v .htaccess kontekstu ni veljaven (samo v glavni konfiguraciji
# strežnika) in je na tem LiteSpeed hostingu povzročil, da je bila CELA mapa
# nedosegljiva (404 na vseh datotekah). RewriteRule je edina varna pot v .htaccess.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} \.git(/|$) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# Klepet je ukinjen (17. 10. 2026), predstavitvena stran odstranjena
# (6. 11. 2026). Na /asistent/ ni vec zacetne datoteke, zato vrne 403 — tako je
# misljeno: pod tem naslovom zivijo samo tools/, ai/ in admin/, vsak s svojo
# potjo. Ce se kdaj vrne javna stran, jo DirectoryIndex spet pokaze.
Options -Indexes
