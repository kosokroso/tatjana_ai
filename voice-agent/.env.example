# LiveKit (Cloud -> Settings -> Keys)
LIVEKIT_URL=wss://tvoj-projekt.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tvoj streznik z orodji in sistemskim promptom
TOOLS_BASE_URL=https://kreativnisplet.si/asistent
TOOL_SECRET=

# OpenAI (prepis govora in model)
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe
# gpt-transcribe je novejsi in edini (poleg gpt-live-transcribe) sprejme
# keywords - usmerjanje prepisa na imena storitev iz kataloga. Pri
# gpt-4o-transcribe se seznam poda samo prek prompta, kar deluje slabse.
# STT_MODEL=gpt-transcribe
LLM_MODEL=gpt-5.4-mini
# auto = ne posljemo je; novejsi modeli je pogosto ne sprejmejo
LLM_TEMPERATURE=auto
LLM_NAPOR=minimal

# Azure - NEOBVEZNO za prvi test. Daje slovenski glas (Petra).
# Brez kljuca agent uporabi OpenAI glas: slabsa slovenscina, a deluje takoj.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=italynorth
# Azure ima za slovenscino samo dva lastna glasova, oba starejse generacije:
# sl-SI-PetraNeural in sl-SI-RokNeural. Vecjezicni glasovi so novejsi in imajo
# boljso melodijo stavka; sl-SI znajo kot dodatni jezik. Katerega vzeti, se ne
# da prebrati iz specifikacij - primerjaj na uho, z istim stavkom pri 16 kHz.
AZURE_TTS_VOICE=sl-SI-PetraNeural
#
# PREIZKUSENO IN ZAVRNJENO: en-US-AvaMultilingualNeural.
# Na vzorcu pri 16 kHz je zvenel bolje od Petre, po telefonu pa slabse.
# Telefonska linija stisne na 8 kHz in to razliko vecjezicni glas prenese
# slabse od lastnega slovenskega. Vzorec v zvocnike torej ni napoved tega,
# kako bo zvenelo v slusalki - primerjaj vedno s pravim klicem.
# AZURE_TTS_VOICE=en-US-AvaMultilingualNeural

# OpenAI glas, kadar Azure ni nastavljen
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=shimmer

# Zaznava premora. Odvisna od tega, kako hitro govorijo pravi klicatelji.
# VAD_TISINA: koliko sekund tisine pomeni "nehal je govoriti".
#   prenizko = asistentka skoci v besedo, previsoko = neroden molk
VAD_TISINA=0.55
VAD_GOVOR=0.10
VAD_PRAG=0.5

# Najdaljsi posamezen klic v sekundah. Velja samo, kadar ai/call-guard.php ni
# dosegljiv - sicer meje doloci CALL_MAX_SECONDS v config.php na gostovanju.
KLIC_MAX_SEK=600

# Tisina. LiveKit po TISINA_VPRASAJ sekundah razglasi sogovornika za odsotnega;
# takrat ga asistentka vprasa, ali je se tam. Ce se v TISINA_KONEC sekundah ne
# oglasi, se poslovi in odlozi.
#
# Brez tega odlozena slusalka poleg telefona tece do KLIC_MAX_SEK - deset minut,
# v katerih tecejo stevci stirih ponudnikov, sogovornika pa ni.
TISINA_VPRASAJ=15
TISINA_KONEC=20


# ---------------------------------------------------------------
# IZBOLJSAVE ZA MERJENJE
#
# Tiste brez # so preizkusene s klici in so v rabi. Zakomentirane cakajo.
#
# Vsaka od teh lahko odziv pospesi ali pa poslabsa razumevanje. Kaj se zgodi,
# je odvisno od linije in od tega, kako govorijo pravi klicatelji, zato se ne
# da vnaprej vedeti. Ko jih je bilo vec vklopljenih hkrati, se ni dalo
# ugotoviti, katera je kaj naredila - in skupaj so odziv poslabsale.
#
# Postopek: odkomentiraj ENO, lk agent update-secrets, opravi nekaj klicev,
# primerjaj. Sele nato naslednjo.
# ---------------------------------------------------------------

# Azure prepis namesto OpenAI. Azure prepisuje sproti in strezniki so v Italiji,
# zato je hitrejsi. Slovenscino pa OpenAI gpt-4o-transcribe razume bolje.
# STT_PONUDNIK=azure
# STT_TISINA_MS=500

# Model zacne sestavljati odgovor, se preden sogovornik utihne. Prihrani skoraj
# sekundo, a odgovori na nedokoncano poved, ce se ta konca drugace.
PREDCASNO=1

# Meje za konec govora. Nizji KONEC_MIN = hitrejsi odziv, a vec prekinjanja.
# Te se sestejejo z VAD_TISINA in STT_TISINA_MS - vsi cakajo na isto tisino.
KONEC_MIN=0.2
# KONEC_MAX=3.0

# Koliko govora od sogovornika utisa asistentko sredi stavka. Privzetih 0.5 s
# zvoka pomeni, da jo utisa vsak sum na liniji. Visje = manj sekanja, a
# pocasnejsi odziv, kadar jo klicatelj res prekine.
# PREKIN_SEK=0.7
# PREKIN_BESEDE=2
# PREKIN_LAZNA=1.5

# Frekvenca govora. 24000 je privzetek pri Azure. 16000 je vredno poskusiti,
# ce se pri daljsih odgovorih pojavi praskanje.
# TTS_SAMPLE_RATE=16000

# Sproten prepis prek websocketa namesto cakanja na konec povedi. Obdrzi isti
# model gpt-4o-transcribe, a odreze velik del tistih 963 ms - brez menjave na
# Azure in brez tveganja za razumevanje slovenscine. Poskusi to PRED azure.
STT_SPROTNO=1

# Zmanjsevanje suma na liniji. near_field = slusalka ob usesu (telefon),
# far_field = mikrofon v prostoru.
# STT_SUM=near_field

# MODEL, KI ODGOVARJA
#
# Zamenjava je ena vrstica. Seznam modelov na racunu:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
#
# Za glas steje troje: razumevanje slovenscine, cas do prve besede in cena.
# Razlicice -pro so za telefon prepocasne, ne glede na kakovost.
#
# LLM_MODEL=gpt-5.4-mini     hiter, dve generaciji novejsi od gpt-4o-mini
# LLM_MODEL=gpt-5.5          boljsi odgovori, vec zamika in visja cena
#
# Ce klic pade z napako o temperaturi, model je ne sprejema - vpisi auto.
# LLM_TEMPERATURE=auto
#
# Novejse druzine razmisljajo pred odgovorom. Po telefonu je to slisna tisina.
# LLM_NAPOR=minimal
# LLM_OBSEZNOST=low
